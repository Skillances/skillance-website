# Skillance Website — copy to .env and fill in values
# Product API: same base URL as the Flutter app (API_BASE_URL)

VITE_API_BASE_URL=https://api.skillance.co.za

# Firebase Web (same Firebase project as the mobile app: skillance-4ec9d)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=skillance-4ec9d.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=skillance-4ec9d
VITE_FIREBASE_MESSAGING_SENDER_ID=935010022760
VITE_FIREBASE_STORAGE_BUCKET=skillance-4ec9d.firebasestorage.app
# Register a Web app in Firebase Console; required for Google sign-in on /app
# Example appId: 1:935010022760:web:7c54b18787aefdc13d52dd
VITE_FIREBASE_APP_ID=

# Marketing contact form (optional)
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
# VITE_EMAILJS_PUBLIC_KEY=

# Admin dev tools (optional)
# VITE_SHOW_BOOKING_DEV_TOOLS=true
# VITE_ADMIN_RQ_DEVTOOLS=true
# VITE_ADMIN_REALTIME_LOGS=true
